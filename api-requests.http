# Devuelve totales agrupados por estado: pending, paid, cancelled
GET {{baseUrl}}/affiliates/commissions/summary
Authorization: Bearer {{token}}

# ── ADMIN: GESTIÓN DE COMISIONES ─────────────────────────────────────────────

