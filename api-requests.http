###############################################################################
# 🔐 AUTENTICACIÓN (AUTH)
###############################################################################

### 1. Registro de Usuario
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "usuario02@ejemplo.com",
  "password": "Password123!",
  "displayName": "Juan Pérez",
  "phone": "+51987654321",
  "dni": "87654321",
  "roles": ["user"]
}

### 2. Login de Usuario
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "usuario02@ejemplo.com",
  "password": "Password123!"
}

### 3. Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### 4. Autenticación con Google (Abrir en navegador)

# GET {{baseUrl}}/auth/google

### 5. Callback de Google (Automático)

# GET {{baseUrl}}/auth/google/callback


###############################################################################
# 👤 PERFIL DE USUARIO (SESION)
###############################################################################

### 1. Obtener Perfil del Usuario Autenticado
GET {{baseUrl}}/sesion/profile
Authorization: Bearer {{token}}

### 2. Actualizar Perfil
PATCH {{baseUrl}}/sesion/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "displayName": "Juan Carlos Pérez",
  "phone": "+51987654322",
  "profilePicture": "https://ejemplo.com/nueva-foto.jpg"
}

### 3. Eliminar Cuenta
DELETE {{baseUrl}}/sesion/profile
Authorization: Bearer {{token}}


###############################################################################
# 👥 GESTIÓN DE USUARIOS (MANAGE - Solo Admin)
###############################################################################

### 1. Crear Usuario
POST {{baseUrl}}/manage/user/create
Content-Type: application/json

{
  "email": "nuevo@ejemplo.com",
  "password": "Password123!",
  "displayName": "Nuevo Usuario",
  "phone": "+51987654321",
  "dni": "12345678",
  "roles": ["user"]
}

### 2. Listar Todos los Usuarios Activos (Admin)
GET {{baseUrl}}/manage/users
Authorization: Bearer {{token}}

### 3. Obtener Usuario por ID (Admin)
GET {{baseUrl}}/manage/user/67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 4. Actualizar Usuario (Admin)
PATCH {{baseUrl}}/manage/user/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "displayName": "Nombre Actualizado",
  "phone": "+51999888777",
  "roles": ["user", "worker"]
}

### 5. Desactivar Usuario (Soft Delete - Admin)
PATCH {{baseUrl}}/manage/user/67890abcdef1234567890abc/deactivate
Authorization: Bearer {{token}}

### 6. Eliminar Usuario Permanentemente (Admin)
DELETE {{baseUrl}}/manage/user/67890abcdef1234567890abc
Authorization: Bearer {{token}}


###############################################################################
# 📦 PRODUCTOS MAESTROS (PRODUCTS)
# GET /product/all    → Admin: activos + inactivos (paginado)
# GET /product/active → Tienda pública: solo activos (paginado)
###############################################################################

### 1. Obtener Todos los Productos — Admin (activos + inactivos)
GET {{baseUrl}}/product/all?page=1&limit=12

### 2. Obtener Solo Productos Activos — Tienda Pública
GET {{baseUrl}}/product/active?page=1&limit=12

### 3. Buscar Productos por Tags
GET {{baseUrl}}/product/search?tags=laptop,gaming

### 4. Obtener Productos por Categoría
GET {{baseUrl}}/product/category/Electrónica

### 5. Obtener Productos por IDs
GET {{baseUrl}}/product/byIds?ids=67890abc,12345def

### 6. Obtener Producto por ID
GET {{baseUrl}}/product/67890abcdef1234567890abc

### 7. Obtener Producto por Código
GET {{baseUrl}}/product/code/BASH-DALLAS

### 8. Buscar Productos por Rango de Precio
GET {{baseUrl}}/product/price-range?minPrice=100&maxPrice=500

### 9. Crear Producto Maestro (Upsert por code)
# Comportamiento:
#   code nuevo           → Crea el producto        (reactivated: false)
#   code existe INACTIVO → Reactiva + actualiza    (reactivated: true)
#   code existe ACTIVO   → Error 400 Conflict
# Respuesta: { product: {...}, reactivated: boolean }
POST {{baseUrl}}/product
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "BASH-DALLAS",
  "name": "Zapatilla Bash Dallas",
  "brand": "Bash",
  "model": "Dallas",
  "description": "Zapatilla urbana de alta calidad",
  "specifications": {
    "material": "Cuero sintético",
    "suela": "Goma antideslizante",
    "tipo": "Casual"
  },
  "basePrice": 199.99,
  "category": ["Calzado", "Zapatillas", "Urbano"],
  "discount": 0,
  "isActive": true,
  "tags": ["zapatilla", "urbano", "casual", "bash"],
  "gallery": [
    "https://res.cloudinary.com/ejemplo/image/upload/v1/lifestyle-1.jpg",
    "https://res.cloudinary.com/ejemplo/image/upload/v1/size-chart.jpg"
  ]
}

### 10. Actualizar Producto Maestro
PATCH {{baseUrl}}/product/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "basePrice": 179.99,
  "discount": 10,
  "tags": ["zapatilla", "oferta", "urbano"],
  "gallery": [
    "https://res.cloudinary.com/ejemplo/image/upload/v1/lifestyle-1.jpg",
    "https://res.cloudinary.com/ejemplo/image/upload/v1/size-chart.jpg"
  ]
}

### 11. Eliminar Producto (Soft Delete - marca como inactivo)
DELETE {{baseUrl}}/product/67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 12. Eliminar Producto Permanentemente (Hard Delete - solo admin)
DELETE {{baseUrl}}/product/67890abcdef1234567890abc/hard
Authorization: Bearer {{token}}


###############################################################################
# 👟 VARIANTES DE PRODUCTOS (PRODUCT VARIANTS)
# GET /product-variants/product/:id → Admin + Tienda: activas e inactivas
###############################################################################

### 1. Obtener Todas las Variantes (Paginado)
GET {{baseUrl}}/product-variants?page=1&limit=12

### 2. Buscar Variante por SKU
GET {{baseUrl}}/product-variants/sku/BASH-DALLAS-WHT-36

### 3. Obtener Variantes de un Producto (activas e inactivas)
GET {{baseUrl}}/product-variants/product/67890abcdef1234567890abc

### 4. Buscar Variantes por Color
GET {{baseUrl}}/product-variants/color/BLU

### 5. Buscar Variantes por Talla
GET {{baseUrl}}/product-variants/size/36

### 6. Obtener Variante por ID
GET {{baseUrl}}/product-variants/67890abcdef1234567890abc

### 7. Calcular Precio Final de Variante
GET {{baseUrl}}/product-variants/67890abcdef1234567890abc/price

### 8. Crear Variante de Producto (Upsert por SKU)
# Comportamiento:
#   SKU nuevo           → Crea la variante         (reactivated: false)
#   SKU existe INACTIVO → Reactiva + actualiza     (reactivated: true)
#   SKU existe ACTIVO   → Error 400 Conflict
# Respuesta: { variant: {...}, reactivated: boolean }
POST {{baseUrl}}/product-variants
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "67890abcdef1234567890abc",
  "sku": "BASH-DALLAS-WHT-36",
  "color": {
    "name": "Blanco",
    "hex": "#FFFFFF",
    "code": "WHT"
  },
  "size": {
    "type": "TALLA",
    "value": "36",
    "region": "EU"
  },
  "dimensions": {
    "weight": {
      "value": 0.5,
      "unit": "kg"
    },
    "length": 25,
    "width": 10,
    "height": 8
  },
  "gallery": [
    "https://ejemplo.com/bash-dallas-white-1.jpg",
    "https://ejemplo.com/bash-dallas-white-2.jpg"
  ],
  "priceAdjustment": 0,
  "isActive": true
}

### 9. Actualizar Variante
PATCH {{baseUrl}}/product-variants/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "priceAdjustment": 10,
  "gallery": [
    "https://ejemplo.com/nueva-imagen-1.jpg",
    "https://ejemplo.com/nueva-imagen-2.jpg"
  ]
}

### 10. Eliminar Variante (Soft Delete)
DELETE {{baseUrl}}/product-variants/67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 11. Eliminar Variante Permanentemente
DELETE {{baseUrl}}/product-variants/67890abcdef1234567890abc/hard
Authorization: Bearer {{token}}


###############################################################################
# 📊 INVENTARIO (INVENTORY)
###############################################################################

### 1. Obtener Todo el Inventario (Paginado)
GET {{baseUrl}}/inventory?page=1&limit=50

### 2. Obtener Inventario de una Tienda
GET {{baseUrl}}/inventory/store/67890abcdef1234567890abc

### 3. Obtener Stock de una Variante en Todas las Tiendas
GET {{baseUrl}}/inventory/variant/67890abcdef1234567890abc

### 4. Obtener Inventario Específico (Variante + Tienda)
GET {{baseUrl}}/inventory/variant/67890abcdef1234567890abc/store/507f1f77bcf86cd799439012

### 5. Verificar Disponibilidad de Stock
GET {{baseUrl}}/inventory/availability/67890abcdef1234567890abc/507f1f77bcf86cd799439012?quantity=2

### 6. Buscar Productos con Stock Bajo
GET {{baseUrl}}/inventory/low-stock

### 7. Buscar Productos con Stock Bajo en una Tienda
GET {{baseUrl}}/inventory/low-stock?storeId=507f1f77bcf86cd799439012

### 8. Buscar Productos Sin Stock
GET {{baseUrl}}/inventory/out-of-stock

### 9. Crear Registro de Inventario
POST {{baseUrl}}/inventory
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "variantId": "67890abcdef1234567890abc",
  "storeId": "507f1f77bcf86cd799439012",
  "quantity": 100,
  "reservedQuantity": 0,
  "location": {
    "aisle": "A",
    "shelf": "3",
    "bin": "12"
  },
  "reorderPoint": 10,
  "reorderQuantity": 50,
  "cost": 89.99,
  "wholesalePrice": 149.99
}

### 10. Reservar Stock (Para Carrito)
POST {{baseUrl}}/inventory/reserve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "variantId": "67890abcdef1234567890abc",
  "storeId": "507f1f77bcf86cd799439012",
  "quantity": 2
}

### 11. Liberar Stock Reservado
POST {{baseUrl}}/inventory/release
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "variantId": "67890abcdef1234567890abc",
  "storeId": "507f1f77bcf86cd799439012",
  "quantity": 2
}

### 12. Reducir Stock (Venta Completada)
PATCH {{baseUrl}}/inventory/reduce/67890abcdef1234567890abc/507f1f77bcf86cd799439012
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 2
}

### 13. Incrementar Stock (Reabastecimiento)
PATCH {{baseUrl}}/inventory/increase/67890abcdef1234567890abc/507f1f77bcf86cd799439012
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 50
}

### 14. Actualizar Inventario
PATCH {{baseUrl}}/inventory/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reorderPoint": 15,
  "reorderQuantity": 75,
  "location": {
    "aisle": "B",
    "shelf": "5",
    "bin": "20"
  }
}

### 15. Eliminar Registro de Inventario
DELETE {{baseUrl}}/inventory/67890abcdef1234567890abc
Authorization: Bearer {{token}}


