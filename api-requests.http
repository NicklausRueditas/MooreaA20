Authorization: Bearer {{token}}

# ── FLUJO COMPLETO: AFILIADO ──────────────────────────────────────────────────
# 1. Admin crea usuario con rol affiliate   (A.1)
# 2. Afiliado referencia órdenes → sistema genera comisiones automáticamente
# 3. Afiliado consulta sus ganancias        (A.2 / A.3)
# 4. Admin revisa comisiones pendientes     (A.6)
# 5. Admin marca como pagadas              (A.7)

# ── PRUEBAS DE SEGURIDAD (Guards) ─────────────────────────────────────────────

### SEC.1. Acceso sin token a ruta protegida → debe retornar 401
GET {{baseUrl}}/product/my-catalog

### SEC.2. Usuario normal intenta crear producto → debe retornar 403
# (usa token de usuario con rol 'user' — no tiene rol admin ni seller)
POST {{baseUrl}}/product
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "TEST-001",
  "name": "Test",
  "brand": "X",
  "model": "X",
  "basePrice": 10,
  "category": ["Test"]
}

### SEC.3. Seller intenta editar producto ajeno → debe retornar 403
# (usa token de seller cuyo ID no coincide con el ownerId del producto)
PATCH {{baseUrl}}/product/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "basePrice": 1
}

### SEC.4. Afiliado intenta acceder a ruta de seller → debe retornar 403
GET {{baseUrl}}/sellers/profile
Authorization: Bearer {{token}}


###############################################################################
# 📋 AUDITORÍA (AUDIT) — Solo Admin
# ──────────────────────────────────────────────────────────────────────────────
# Registra cada acción de gestión realizada por admin/seller/affiliate/worker.
# Los registros se crean automáticamente — estos endpoints son solo de consulta.
#
# Acciones registradas automáticamente:
#   USER_CREATED / USER_UPDATED / USER_ROLES_CHANGED / USER_DEACTIVATED / USER_DELETED
#   SELLER_PROFILE_CREATED / SELLER_PROFILE_UPDATED / SELLER_APPROVED / SELLER_REJECTED
#   PRODUCT_CREATED / PRODUCT_UPDATED / PRODUCT_ACTIVATED / PRODUCT_DEACTIVATED / PRODUCT_DELETED
#   VARIANT_CREATED / VARIANT_UPDATED / VARIANT_ACTIVATED / VARIANT_DEACTIVATED / VARIANT_DELETED
#   COMMISSION_PAID / USER_LOGIN / USER_LOGOUT
###############################################################################

### AUD.1. Historial completo (sin filtros, paginado)
GET {{baseUrl}}/audit?page=1&limit=20
Authorization: Bearer {{token}}

### AUD.2. Filtrar por tipo de acción
GET {{baseUrl}}/audit?action=USER_ROLES_CHANGED&page=1&limit=20
Authorization: Bearer {{token}}

### AUD.3. Filtrar por entidad afectada
GET {{baseUrl}}/audit?targetEntity=PRODUCT&page=1
Authorization: Bearer {{token}}

### AUD.4. Filtrar por usuario que realizó la acción
GET {{baseUrl}}/audit?userId=67890abcdef1234567890abc&page=1
Authorization: Bearer {{token}}

### AUD.5. Filtrar por documento afectado (targetId)
GET {{baseUrl}}/audit?targetId=67890abcdef1234567890abc&page=1
Authorization: Bearer {{token}}

### AUD.6. Filtrar por rango de fechas
GET {{baseUrl}}/audit?from=2026-03-01&to=2026-03-31&page=1
Authorization: Bearer {{token}}

### AUD.7. Combinación de filtros (acción + rango de fechas)
GET {{baseUrl}}/audit?action=SELLER_APPROVED&from=2026-03-01&to=2026-03-31
Authorization: Bearer {{token}}

### AUD.8. Historial de acciones de un usuario específico
# Retorna todas las acciones realizadas POR ese usuario (como actor)
GET {{baseUrl}}/audit/user/67890abcdef1234567890abc?page=1&limit=20
Authorization: Bearer {{token}}

