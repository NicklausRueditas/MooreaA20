### 1. Crear Tienda
POST {{baseUrl}}/stores
Content-Type: application/json

{
  "name": "Tienda Central",
  "address": "Av. Principal 123, Lima",
  "lat": -12.046373,
  "lng": -77.042754,
  "phone": "+51999999999",
  "email": "central@tienda.com",
  "isActive": true,
  "businessHours": [
    {
      "dayOfWeek": 1,
      "openTime": "09:00",
      "closeTime": "18:00",
      "isOpen": true
    },
    {
      "dayOfWeek": 2,
      "openTime": "09:00",
      "closeTime": "18:00",
      "isOpen": true
    }
  ]
}

### 2. Obtener Todas las Tiendas
GET {{baseUrl}}/stores

### 3. Obtener Solo Tiendas Activas
GET {{baseUrl}}/stores/active

### 4. Obtener Tienda por ID
GET {{baseUrl}}/stores/67890abcdef1234567890abc

### 5. Actualizar Tienda
PATCH {{baseUrl}}/stores/67890abcdef1234567890abc
Content-Type: application/json

{
  "name": "Tienda Central Actualizada",
  "isActive": false
}

### 6. Eliminar Tienda
DELETE {{baseUrl}}/stores/67890abcdef1234567890abc

### 7. Agregar Trabajador a Tienda
POST {{baseUrl}}/stores/67890abcdef1234567890abc/workers
Content-Type: application/json

{
  "userId": "507f1f77bcf86cd799439011",
  "role": "manager"
}

### 8. Agregar Zona de Cobertura
POST {{baseUrl}}/stores/67890abcdef1234567890abc/coverage-zones
Content-Type: application/json

{
  "name": "Centro de Lima",
  "coordinates": [
    [-77.042754, -12.046373],
    [-77.042754, -12.056373],
    [-77.032754, -12.056373],
    [-77.032754, -12.046373],
    [-77.042754, -12.046373]
  ],
  "deliveryFee": 5.0
}




