Authorization: Bearer {{token}}

# ── CATÁLOGO DEL SELLER (usa ProductsController) ─────────────────────────────
# Con el nuevo modelo de catálogos independientes, el seller gestiona sus
# propios productos directamente a través de /product.
# Cada producto creado por un seller queda con ownerId = su ID.

### S.9. Ver mi catálogo privado (Seller autenticado — solo sus productos)
GET {{baseUrl}}/product/my-catalog?page=1&limit=12
Authorization: Bearer {{token}}

### S.10. Crear producto en mi catálogo (Seller aprobado)
# El backend asigna automáticamente ownerId = ID del seller autenticado.
POST {{baseUrl}}/product
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "TIENDA-ZAPATO-001",
  "name": "Zapatilla Exclusiva Tienda",
  "brand": "MiBrand",
  "model": "Modelo A",
  "description": "Producto propio del seller",
  "basePrice": 189.90,
  "category": ["Calzado", "Zapatillas"],
  "discount": 5,
  "isActive": true,
  "tags": ["zapatilla", "exclusivo"],
  "gallery": ["https://cdn.ejemplo.com/producto1.jpg"]
}

### S.11. Actualizar mi producto (solo si soy el dueño)
PATCH {{baseUrl}}/product/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "basePrice": 175.00,
  "discount": 10,
  "tags": ["zapatilla", "oferta"]
}

### S.12. Desactivar mi producto (soft delete — solo si soy el dueño)
PATCH {{baseUrl}}/product/67890abcdef1234567890abc/deactivate
Authorization: Bearer {{token}}

### S.13. Activar mi producto (solo si soy el dueño)
PATCH {{baseUrl}}/product/67890abcdef1234567890abc/activate
Authorization: Bearer {{token}}

### S.14. Eliminar mi producto permanentemente (solo si soy el dueño)
DELETE {{baseUrl}}/product/67890abcdef1234567890abc
Authorization: Bearer {{token}}

# ── CATÁLOGO PÚBLICO (maestro — todos los owners) ─────────────────────────────

### S.15. Ver catálogo maestro público (productos de Moorea + todos los sellers)
GET {{baseUrl}}/product/active?page=1&limit=12

# ── FLUJO COMPLETO: SELLER NUEVO ──────────────────────────────────────────────
# 1. Admin crea usuario con rol seller            (S.1)
# 2. Seller hace login → obtiene token
# 3. Seller crea su perfil de tienda              (S.2)
# 4. Admin ve sellers pendientes                  (S.6)
# 5. Admin aprueba al seller                      (S.7)
# 6. Seller crea sus productos propios            (S.10)
# 7. Público ve el catálogo maestro unificado     (S.15)


