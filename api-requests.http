DELETE {{baseUrl}}/product/67890abcdef1234567890abc
Authorization: Bearer {{token}}


###############################################################################
# 🛒 CARRITO DE COMPRAS (BASKET)
# IMPORTANTE: todos los endpoints usan variantId (ObjectId de ProductVariant).
# El cliente debe elegir talla + color ANTES de agregar al carrito.
# Flujo: GET /product-variants/product/:productId → elegir variante → POST /basket/add
###############################################################################

### 1. Obtener Carrito Completo con Cálculos
# Respuesta unificada — shape:
# {
#   "items": [
#     {
#       "variantId": "...",
#       "productId": "...",
#       "variant": { "_id": "...", "sku": "BASH-DALLAS-WHT-36", "color": { "name": "Blanco", "hex": "#FFF", "code": "WHT" },
#                    "size": { "type": "TALLA", "value": "36", "region": "EU" }, "gallery": [...], "priceAdjustment": 0 },
#       "product":  { "_id": "...", "name": "Zapatilla Bash Dallas", "brand": "Bash", "basePrice": 199.99, "discount": 10 },
#       "quantity": 2,
#       "finalPrice": 199.99,
#       "discount": 10,
#       "subtotal": 359.98,
#       "savings": 39.998
#     }
#   ],
#   "summary": {
#     "itemCount": 1,
#     "totalQuantity": 2,
#     "totalWithoutDiscount": 399.98,
#     "totalWithDiscount": 359.98,
#     "totalSavings": 39.998
#   }
# }
GET {{baseUrl}}/basket
Authorization: Bearer {{token}}

### 2. Inicializar/Obtener Carrito Básico (sin cálculos)
GET {{baseUrl}}/basket/init
Authorization: Bearer {{token}}

### 3. Obtener Resumen del Carrito (itemCount, totalQuantity, estimatedTotal)
GET {{baseUrl}}/basket/summary
Authorization: Bearer {{token}}

### 4. Verificar si una Variante está en el Carrito
GET {{baseUrl}}/basket/check/67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 5. Agregar Variante al Carrito
# Validaciones automáticas: variante activa, producto activo, stock disponible en Inventory
POST {{baseUrl}}/basket/add
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "variantId": "67890abcdef1234567890abc",
  "quantity": 2
}

### 6. Actualizar Cantidad de Variante (valor absoluto — reemplaza la cantidad actual)
PATCH {{baseUrl}}/basket/update/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 5
}

### 7. Ajustar Cantidad (Incrementar +1)
PATCH {{baseUrl}}/basket/adjust/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "change": 1
}

### 8. Ajustar Cantidad (Decrementar -1 — si el resultado ≤ 0 se elimina el item)
PATCH {{baseUrl}}/basket/adjust/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "change": -1
}

### 9. Eliminar Variante del Carrito
DELETE {{baseUrl}}/basket/remove/67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 10. Vaciar Carrito Completo
DELETE {{baseUrl}}/basket/clear
Authorization: Bearer {{token}}


###############################################################################
# 🛍️ ÓRDENES (ORDERS)
# Flujo: el frontend agrupa el carrito por fulfillment y llama POST /orders una vez por grupo.
# Ejemplo con carrito mixto delivery+pickup → 2 llamadas a POST /orders con variantIds distintos.
###############################################################################

### 1. Crear Orden — Delivery (toda la canasta o un subconjunto)
POST {{baseUrl}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fulfillment": "delivery",
  "paymentMethod": "card",
  "addressId": "67890abcdef1234567890abc"
}

### 2. Crear Orden — Delivery con subset del carrito (carrito mixto)
POST {{baseUrl}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fulfillment": "delivery",
  "paymentMethod": "card",
  "addressId": "67890abcdef1234567890abc",
  "variantIds": ["67890abcdef1234567890ab1", "67890abcdef1234567890ab2"]
}

### 3. Crear Orden — Pickup en tienda
POST {{baseUrl}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fulfillment": "pickup",
  "paymentMethod": "yape",
  "storeId": "67890abcdef1234567890abc",
  "variantIds": ["67890abcdef1234567890ab3"]
}

### 4. Mis Órdenes (historial del usuario autenticado)
GET {{baseUrl}}/orders/my
Authorization: Bearer {{token}}

### 5. Detalle de Mi Orden
GET {{baseUrl}}/orders/my/67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 6. Datos QR para Retiro en Tienda (generado on-demand, no persistido)
# Devuelve { pickupCode, invoiceNumber, qrContent }
# El frontend/app genera el QR visual a partir de qrContent
GET {{baseUrl}}/orders/my/67890abcdef1234567890abc/qr
Authorization: Bearer {{token}}

### 7. Confirmar Retiro en Tienda (cajero escanea el QR)
# El cajero usa el pickupCode del QR — marca la orden como DELIVERED
PATCH {{baseUrl}}/orders/pickup/confirm/PKP-8F3X2K
Authorization: Bearer {{token}}

### 8. Todas las Órdenes [Admin] — Sin filtros
GET {{baseUrl}}/orders/all
Authorization: Bearer {{token}}

### 9. Todas las Órdenes [Admin] — Filtrar por estado
GET {{baseUrl}}/orders/all?status=pending_payment
Authorization: Bearer {{token}}

### 10. Todas las Órdenes [Admin] — Filtrar por fulfillment
GET {{baseUrl}}/orders/all?fulfillment=pickup
Authorization: Bearer {{token}}

### 11. Todas las Órdenes [Admin] — Pickup de una tienda específica
GET {{baseUrl}}/orders/all?fulfillment=pickup&storeId=67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 12. Actualizar Estado de Orden [Admin/Worker] — Marcar como pagada
PATCH {{baseUrl}}/orders/67890abcdef1234567890abc/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "paid"
}

### 13. Actualizar Estado — Preparando
PATCH {{baseUrl}}/orders/67890abcdef1234567890abc/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "preparing"
}

### 14. Actualizar Estado — Listo para Retiro (pickup)
PATCH {{baseUrl}}/orders/67890abcdef1234567890abc/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "ready_for_pickup"
}

### 15. Actualizar Estado — Enviado (delivery)
PATCH {{baseUrl}}/orders/67890abcdef1234567890abc/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "shipped"
}

### 16. Cancelar Orden (cancelReason obligatorio)
PATCH {{baseUrl}}/orders/67890abcdef1234567890abc/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "cancelled",
  "cancelReason": "Sin stock disponible para completar el pedido"
}

# ── IZIPAY — PAGO CON TARJETA ──────────────────────────────────────────────────────────────
# Flujo: 17 → (Angular monta el formulario embebido de Izipay) → 18 (webhook automático)
# Req: IZIPAY_SHOP_ID, IZIPAY_PASSWORD e IZIPAY_HMAC_KEY configurados en .env

### 17. Iniciar Pago con Izipay (obtener formToken para el formulario embebido)
# Devuelve { formToken, publicKey, jsUrl, amount, invoiceNumber, currency }
# El frontend:
#   1. Carga jsUrl en el <head>
#   2. KRGlue.loadLibrary(jsUrl, publicKey)
#      .then(() => KRGlue.setFormConfig({ "kr-public-key": publicKey, "formToken": formToken }))
#   3. Monta el formulario embebido — Izipay maneja todo (validación, 3DS, etc.)
POST {{baseUrl}}/orders/67890abcdef1234567890abc/payment/init
Authorization: Bearer {{token}}

### 18. Webhook de Izipay — llamado automáticamente por Izipay al finalizar el pago
# Izipay hace POST con los campos: kr-answer (JSON), kr-hash, kr-hash-algorithm
# URL configurada en el portal Izipay → Configuración → Notificaciones → URL de notificación
# La URL en .env: IZIPAY_WEBHOOK_URL=http://localhost:3000/orders/izipay/webhook
# ⚠️  NO llamar manualmente — el backend verifica la firma HMAC-SHA256 antes de procesar
POST {{baseUrl}}/orders/izipay/webhook
Content-Type: application/x-www-form-urlencoded

kr-answer={"orderStatus":"PAID","orderId":"ORD-2026-00001","transactions":[{"uuid":"test-tx-id","amount":34999,"currency":"PEN","status":"PAID","cardDetails":{"effectiveBrand":"VISA","pan":"490000XXXXXX1001"}}]}&kr-hash=firma_hmac_sha256_generada_por_izipay&kr-hash-algorithm=sha256_hmac



###############################################################################
# 📍 DIRECCIONES (ADDRESSES)
###############################################################################

### 1. Crear Nueva Dirección
POST {{baseUrl}}/addresses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "address": {
    "alias": "Casa Cuarta",
    "street": "Av. loreto",
    "streetNumber": "4321",
    "apartment": "103",
    "district": "El Tambo",
    "province": "Huancayo",
    "department": "Junín",
    "postalCode": "12701",
    "country": "PE",
    "references": "Cerca a la plaza de armas",
    "isDefault": true,
    "lat": -12.072505,
    "lng": -75.232241,
    "placeId": "ChIJx1vQD8o9BZERX9lH3Q8wMwc",
    "distanceFromStore": 2.5
  }
}

### 2. Obtener Todas las Direcciones del Usuario
GET {{baseUrl}}/addresses
Authorization: Bearer {{token}}

### 3. Obtener Dirección Predeterminada
GET {{baseUrl}}/addresses/default
Authorization: Bearer {{token}}

### 4. Obtener Dirección por ID
GET {{baseUrl}}/addresses/67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 5. Actualizar Dirección
PATCH {{baseUrl}}/addresses/67890abcdef1234567890abc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "address": {
    "alias": "Casa Actualizada",
    "street": "Av. Larco",
    "streetNumber": "5678",
    "district": "Miraflores",
    "province": "Lima",
    "department": "Lima",
    "postalCode": "15074",
    "country": "PE",
    "isDefault": false
  }
}

### 6. Establecer Dirección como Predeterminada
PATCH {{baseUrl}}/addresses/67890abcdef1234567890abc/default
Authorization: Bearer {{token}}

### 7. Eliminar Dirección Específica
DELETE {{baseUrl}}/addresses/67890abcdef1234567890abc
Authorization: Bearer {{token}}

### 8. Eliminar Todas las Direcciones
DELETE {{baseUrl}}/addresses
Authorization: Bearer {{token}}


###############################################################################
# 🖼️ IMÁGENES (IMAGES) - Cloudinary
###############################################################################

### 1. Subir Imagen a Cloudinary
POST {{baseUrl}}/image/upload
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="producto.jpg"
Content-Type: image/jpeg

< ./path/to/image.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 2. Obtener Todas las Imágenes
GET {{baseUrl}}/image/all

### 3. Obtener Todas las Imágenes (Incluir Inactivas)
GET {{baseUrl}}/image/all?includeInactive=true

### 4. Obtener Imágenes de un Usuario
GET {{baseUrl}}/image/user/698945136e9c96832d8dfe07
Authorization: Bearer {{token}}

### 5. Obtener Imagen por Cloudinary ID (Metadata)
GET {{baseUrl}}/image/tienda-virtual/gi9wwkhnk1nryp5dsvxq

### 6. Actualizar Metadata de Imagen
PATCH {{baseUrl}}/image/tienda-virtual/gi9wwkhnk1nryp5dsvxq
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": false
}

### 7. Desactivar Imagen (Soft Delete)
PATCH {{baseUrl}}/image/tienda-virtual/gi9wwkhnk1nryp5dsvxq/deactivate
Authorization: Bearer {{token}}

### 8. Eliminar Imagen Permanentemente (DB + Cloudinary)
DELETE {{baseUrl}}/image/tienda-virtual/gi9wwkhnk1nryp5dsvxq
Authorization: Bearer {{token}}




###############################################################################
# 🏪 TIENDAS (STORES)
